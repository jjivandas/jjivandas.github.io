---
layout: layouts/base.njk
title: Projects
---
<section class="section">
  <h1>Projects</h1>
  <p>Here are a few projects I have worked on</p>
  <div class="grid">
    {% for project in projects %}
      <article class="list-card">
        <h2><a href="/projects/{{ project.slug }}/">{{ project.title }}</a></h2>
        <ul class="tight-list">
          <li>{{ project.description }}</li>
          {% if project.details and project.details.length %}
            <li>{{ project.details[0] }}</li>
          {% endif %}
          <li><strong>Tech used:</strong> {{ project.tech }}</li>
        </ul>
        {% if project.links.length %}
          <div class="footer-links">
            {% for link in project.links %}
              <a href="{{ link.url }}">{{ link.label }}</a>
            {% endfor %}
          </div>
        {% endif %}
      </article>
    {% endfor %}
  </div>
</section>
