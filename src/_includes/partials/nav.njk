<header class="site-header">
  <div class="brand">
    <a href="/">Jay Jivandas</a>
  </div>
  <nav class="site-nav">
    {% for link in site.nav %}
      {% set isCurrent = page.url == link.url if link.url == "/" else page.url.startsWith(link.url) %}
      <a href="{{ link.url }}"{% if isCurrent %} aria-current="page"{% endif %}>{{ link.label }}</a>
    {% endfor %}
    <button class="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
      <span class="theme-icon-light" aria-hidden="true">☾</span>
      <span class="theme-icon-dark" aria-hidden="true">☀</span>
    </button>
  </nav>
</header>
