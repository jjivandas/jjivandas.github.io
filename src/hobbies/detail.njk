---
layout: layouts/base.njk
pagination:
  data: hobbies
  size: 1
  alias: hobby
permalink: "/hobbies/{{ hobby.slug }}/index.html"
eleventyComputed:
  title: "{{ hobby.title }}"
---
<section class="section">
  <a href="/hobbies/">Back to Hobbies</a>
  <h1>{{ hobby.title }}</h1>
  <p>{{ hobby.summary }}</p>
</section>

{% if hobby.slug == "books" %}
<section class="section">
  {{ markdownContent.books | safe }}
</section>
{% else %}
<section class="section">
  <h2>Details</h2>
  <ul>
    {% for detail in hobby.details %}
      <li>{{ detail }}</li>
    {% endfor %}
  </ul>
</section>
{% endif %}

{% if hobby.slug == "cooking" and hobby.recipes and hobby.recipes.length %}
<section class="section">
  <h2>Recipes</h2>
  <div class="tabs" data-tabs="cooking">
    <div class="tab-list" role="tablist" aria-label="Cooking recipes">
      {% for recipe in hobby.recipes %}
        <button class="tab-button" role="tab" type="button" aria-selected="{% if loop.first %}true{% else %}false{% endif %}" data-tab="recipe-{{ loop.index }}">{{ recipe.title }}</button>
      {% endfor %}
    </div>
    <div class="tab-panels">
      {% for recipe in hobby.recipes %}
        <div class="tab-panel" role="tabpanel" data-panel="recipe-{{ loop.index }}" {% if not loop.first %}hidden{% endif %}>
          {% if recipe.image %}
            <img class="recipe-image" src="{{ recipe.image }}" alt="{{ recipe.title }} placeholder image">
          {% endif %}
          <p>{{ recipe.description | replace('\n', '<br>') | safe }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<script>
  (function () {
    var container = document.querySelector('[data-tabs="cooking"]');
    if (!container) return;
    var buttons = container.querySelectorAll('.tab-button');
    var panels = container.querySelectorAll('.tab-panel');
    buttons.forEach(function (button) {
      button.addEventListener('click', function () {
        var target = button.getAttribute('data-tab');
        buttons.forEach(function (btn) {
          btn.setAttribute('aria-selected', btn === button ? 'true' : 'false');
        });
        panels.forEach(function (panel) {
          panel.hidden = panel.getAttribute('data-panel') !== target;
        });
      });
    });
  })();
</script>
{% endif %}

{% if hobby.links.length %}
<section class="section">
  <h2>Links</h2>
  <ul>
    {% for link in hobby.links %}
      <li><a href="{{ link.url }}">{{ link.label }}</a></li>
    {% endfor %}
  </ul>
</section>
{% endif %}

{% if hobby.image and hobby.slug != "music" %}
<section class="section">
  <img class="hobby-hero-image" src="{{ hobby.image }}" alt="{{ hobby.title }} placeholder image">
</section>
{% endif %}
