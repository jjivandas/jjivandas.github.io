---
layout: layouts/base.njk
pagination:
  data: career
  size: 1
  alias: item
permalink: "/career/{{ item.slug }}/index.html"
title: "{{ item.role }}"
---
<section class="section">
  <a href="/career/">Back to Career</a>
  <h1>{{ item.role }}</h1>
  <p><strong>{{ item.organization }}</strong> · {{ item.location }} · {{ item.dateRange }}</p>
  {% if item.highlights and item.highlights.length %}
    <ul>
      {% for highlight in item.highlights %}
        <li>{{ highlight }}</li>
      {% endfor %}
    </ul>
  {% else %}
    <p>{{ item.summary }}</p>
  {% endif %}
</section>

<section class="section">
  <h2>What I did</h2>
  <ul>
    {% for detail in item.whatIDid %}
      <li>{{ detail }}</li>
    {% endfor %}
  </ul>
</section>

<section class="section">
  <h2>What I learned</h2>
  <ul>
    {% for detail in item.whatILearned %}
      <li>{{ detail }}</li>
    {% endfor %}
  </ul>
</section>

{% if item.images.length %}
<section class="section">
  <h2>Images</h2>
  <div class="grid two">
    {% for image in item.images %}
      <img src="{{ image }}" alt="{{ item.role }} placeholder image">
    {% endfor %}
  </div>
</section>
{% endif %}

{% if item.links.length %}
<section class="section">
  <h2>Links</h2>
  <ul>
    {% for link in item.links %}
      <li><a href="{{ link.url }}">{{ link.label }}</a></li>
    {% endfor %}
  </ul>
</section>
{% endif %}
